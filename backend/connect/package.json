  "description": "The /connect sign-in page (Privy + link a pc.0g.ai key), bundled into one file by esbuild",
  "scripts": { "build": "esbuild main.jsx --bundle --minify --format=esm --target=es2020 --define:process.env.NODE_ENV='\"production\"' --alias:@solana-program/system=./stub.cjs --alias:@solana-program/token=./stub.cjs --alias:@solana/kit=./stub.cjs --outfile=../public/connect.js" },
  "dependencies": { "@privy-io/react-auth": "3.51.3", "react": "18.3.1", "react-dom": "18.3.1" },
  "devDependencies": { "esbuild": "0.25.10" }
