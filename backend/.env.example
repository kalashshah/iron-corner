# Copy to backend/.env. Wallet keys can also live in ~/.iron-corner/wallets.env (loaded automatically).
# Each integration runs live when its credentials exist, mock otherwise; force with live|mock.
ZG_MODE=
ZG_STORAGE_MODE=
HEDERA_MODE=
WORLD_MODE=

# 0G inference (router)
ZG_API_KEY=
ZG_BASE_URL=
ZG_CHAT_MODEL=
ZG_STT_MODEL=
DECIDE_TIMEOUT_MS=

# 0G Storage
OG_OPS_PRIVATE_KEY=
ZG_RPC=
ZG_INDEXER=
BRAIN_SECRET=

# Hedera / x402
HEDERA_OPERATOR_PRIVATE_KEY=
HEDERA_OPERATOR_ID=
BOT_A_PRIVATE_KEY=
BOT_B_PRIVATE_KEY=
PAY_ASSET=
TINYBAR_PER_CENT=
USDC_TOKEN_ID=
X402_FACILITATOR_URL=

# World IdP
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=
WORLD_ISSUER=
WORLD_ACR=
MOCK_APPROVE_MS=

# Server
PORT=
SELF_URL=
STATE_FILE=
