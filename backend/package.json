{
  "name": "iron-corner-backend",
  "version": "1.0.0",
  "description": "Iron Corner backend",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "smoke": "tsx scripts/smoke.ts",
    "check": "STATE_FILE=selfcheck.json sh -c 'for f in game demos match engine camp; do tsx src/$f.ts || exit 1; done; rm -f data/selfcheck.json'"
