    "@x402/express": "2.30.0",
    "@x402/fetch": "2.30.0",
    "@x402/hedera": "2.30.0",
    "ethers": "^6.13.1",
    "express": "^5.3.0",
    "openai": "^7.51.0",
    "openid-client": "^6.8.9",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15"
  },
  "private": true
}
